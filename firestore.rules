rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.role == "admin";
    }

    function isDealer() {
      return request.auth != null &&
             request.auth.token.role == "dealer";
    }

    function isCustomer() {
      return request.auth != null &&
             request.auth.token.role == "customer";
    }

    /* 🔋 BATTERIES */
    match /batteries/{batteryId} {

      // Admin = full control
      allow read, write: if isAdmin();

      // Dealer = read only his batteries
      allow read: if isDealer() &&
        resource.data.dealerId == request.auth.uid;

      // Customer = read only
      allow read: if isCustomer() &&
        resource.data.customerId == request.auth.uid;

      // ❌ Nobody else can write
      allow write: if false;
    }

    /* 📄 WARRANTY CLAIMS */
    match /claims/{claimId} {
      allow create: if isDealer();
      allow read, update: if isAdmin();
    }

    /* 🔐 COMMANDS (LOCK/UNLOCK) */
    match /commands/{cmdId} {
      allow create: if isAdmin();
      allow read: if isAdmin() || isDealer();
    }
  }
}
